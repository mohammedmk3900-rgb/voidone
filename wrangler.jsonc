{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voidone",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0580a75f-4585-46ac-8236-0446c81caf62","database_name": "voidone" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3dec6705671441b6aca3fb330e444559" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
